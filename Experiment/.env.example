# Copy to Experiment/.env and fill in real values.
# The experiment loads this file first, and only falls back to
# Retrival-Mem/.env when it does not exist, so the upstream checkouts stay
# untouched.

# --- Ollama: embedding + controller / window planner / entity judge ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_EMBED_ENDPOINT=http://127.0.0.1:11434/api/embed
OLLAMA_LEGACY_EMBEDDINGS_ENDPOINT=http://127.0.0.1:11434/api/embeddings

# --- Ollama containers (point 16): one lane per persona worker, comma separated ---
# Every persona worker owns one container, round robin; a single URL (or no
# OLLAMA_BASE_URLS at all) keeps the one-container behaviour.
# The Ollama stages are the bottleneck of the memory + retrieval path (measured
# 2026-09-21: retrieval 141 s/question, 99% of the answer stage with five workers
# queueing on one container), so list every GPU the server exposes. The school
# GPU server publishes:
#   http://172.26.94.12:41133  (ollama021-2-1, device4)
#   http://172.26.94.12:41134  (ollama021-2-2, device5)  <- start the container first
#   http://172.26.94.12:41135  (ollama021-1,   device6)  <- single-process default
#   http://172.26.94.12:41136  (ollama021,     device7)
# Start commands (on the GPU server) and the full recipe live in Experiment/README.md.
# run_experiment.py probes every lane at startup and stops if one is down;
# --allow-missing-units runs on the lanes that answer instead.
# Verify the lanes before a long run:
#   python Experiment\tools\check_ollama_units.py --units http://172.26.94.12:41133,http://172.26.94.12:41134,http://172.26.94.12:41135,http://172.26.94.12:41136,http://172.26.94.12:41137,http://172.26.94.12:41138
OLLAMA_BASE_URLS=http://172.26.94.12:41135,http://172.26.94.12:41136,http://172.26.94.12:41133,http://172.26.94.12:41134,http://172.26.94.12:41137,http://172.26.94.12:41138

# --- DashScope Bailian: embedding + control roles ---
# Bailian serves no OpenAI model, and since point 33 every cloud role is one
# (memory construction openai/gpt-4o-mini, answering and judging
# openai/gpt-5-mini), so no role of eval_large.yaml or eval_large_bailian.yaml
# goes through Bailian any more. What is left here is
#   * configs/eval_large_bailian_all.yaml: embedding (text-embedding-v4) and the
#     window_planner / controller / entity_judge roles (qwen3.5-flash), for a
#     host that cannot reach the campus Ollama;
#   * configs/smoke_small.yaml: the all-Bailian plumbing smoke test.
# Bailian renames third-party models, so the `model:` values there must be the
# ids Bailian actually serves. Verify in one call before a long run:
#   python Experiment\tools\check_channels.py --config Experiment\configs\eval_large_bailian_all.yaml --roles embedding,window_planner,controller
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_COMPLETIONS_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- OpenRouter: memory construction (gpt-4o-mini) + answering and judging
#     (gpt-5-mini) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_COMPLETIONS_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- Network routing (measured on this machine, 2026-09-20) ---
# Windows runs a system proxy at 127.0.0.1:7897 (Clash and friends) and Python
# picks it up from the registry. openrouter.ai MUST go through it: OpenAI's
# models answer 403 "This model is not available in your region" when dialled
# directly from a CN IP (measured: direct 4/4 failures, proxy 4/4 successes).
#
# So DO NOT SET NO_PROXY / no_proxy here or in the shell. Python's
# urllib.request.getproxies() prefers the environment over the registry, so any
# NO_PROXY value makes it drop the system proxy entirely -- measured:
#   unset        -> getproxies() = {'http': 'http://127.0.0.1:7897', ...}
#   NO_PROXY=... -> getproxies() = {'no': '172.26.94.12,...'}   (no proxy!)
# The GPU server is dialled directly through the registry's 172.26.*
# ProxyOverride, so it needs no NO_PROXY entry either.
#
# Keep the proxy running for the whole run; the chat clients we build retry
# transient proxy/SSL blips (MEMCONFLICT_CHAT_RETRIES, default 3).

# --- Alternative channels (configs/eval_china_channels.yaml) ---
# OpenRouter geo-gates this machine ("This model is not available in your
# region"), so the cloud roles can be pointed at vendor-direct endpoints
# instead. Both are OpenAI-compatible with Bearer auth, so they need no code
# change: the config declares these env names and the preflight follows them.
#
# Baidu Qianfan (or Zhipu BigModel: https://open.bigmodel.cn/api/paas/v4/chat/completions)
QIANFAN_API_KEY=
QIANFAN_CHAT_COMPLETIONS_ENDPOINT=https://qianfan.baidubce.com/v2/chat/completions

# Azure OpenAI for the judge (point 33: openai/gpt-5-mini): it does NOT take
# Authorization: Bearer, so it uses the azure provider in
# memconflict_eval/azure_client.py (api-key header plus the
# /openai/deployments/<deployment>/chat/completions path and api-version). A
# config can override the deployment per role with `extra.deployment`.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_API_KEY=
# Optional: "authorization" when an internal gateway wants a Bearer token.
AZURE_OPENAI_AUTH_HEADER=api-key

# --- DeepSeek direct (region-safe judge fallback, verified working) ---
# Used by configs/eval_large_dsjudge.yaml, which keeps the runner on OpenRouter.
OPENAI_API_KEY=
OPENAI_CHAT_COMPLETIONS_ENDPOINT=https://api.deepseek.com/chat/completions
