# Copy to `.env` and fill in real values. `load_config()` reads `.env` from the
# repository root, so run scripts from this directory.

# --- Ollama (embedding + controller / window planner / entity judge) ---
# Service base URL, used by the optional --ollama-units-config routing only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Endpoints consumed by the Ollama chat and embedding clients.
OLLAMA_CHAT_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_EMBED_ENDPOINT=http://127.0.0.1:11434/api/embed
OLLAMA_LEGACY_EMBEDDINGS_ENDPOINT=http://127.0.0.1:11434/api/embeddings

# --- DashScope Bailian (memory builder, adjudication, answer model) ---
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_COMPLETIONS_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- OpenRouter (judge model) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_COMPLETIONS_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- OpenAI-compatible providers (only needed by configs that select them) ---
# OPENAI_API_KEY=
# OPENAI_CHAT_COMPLETIONS_ENDPOINT=
